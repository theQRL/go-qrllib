      "kind": "detached",
      "bytes": "",
      "expected": "valid",
      "note": "the one accepted encoding"
    },
    {
      "name": "detached, one trailing zero byte",
      "kind": "detached",
      "bytes": "",
      "expected": "invalid"
    },
    {
      "name": "detached, zero-padded to 1280 bytes",
      "kind": "detached",
      "bytes": "",
      "expected": "invalid",
      "note": "falcon-padded-1024 length; PQClean falcon-1024 (pqclean.c, do_verify) and liboqs accept this form"
    },
    {
      "name": "detached, padded to 1280 bytes ending in a non-zero byte",
      "kind": "detached",
      "bytes": "",
      "expected": "invalid",
      "note": "rejected by every implementation"
    },
    {
      "name": "signed message, compact",
      "kind": "signedMessage",
      "bytes": "",
      "expected": "valid"
    },
    {
      "name": "signed message, signature field raised over zero padding to a 1239-byte body",
      "kind": "signedMessage",
      "bytes": "",
      "expected": "invalid",
      "note": "PQClean crypto_sign_open accepts this form"
    },
    {
      "name": "signed message, one trailing byte beyond the declared length",
